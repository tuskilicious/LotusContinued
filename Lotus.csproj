<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Description>Project Lotus</Description>
    <Authors>Tealeaf, Discussions</Authors>
    <RootNamespace>Lotus</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <Deterministic>false</Deterministic>
    <DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);.dependencies/**;tests/**</DefaultItemExcludes>
    <Optimize>True</Optimize>
  </PropertyGroup>
  
  <PropertyGroup>
        <GameVersion>2026.9.29</GameVersion>
        <VentFrameworkPath Condition="'$(VentFrameworkPath)' == ''">$(MSBuildProjectDirectory)/.dependencies/VentFramework-Continued/bin/Release/net6.0/VentFrameworkContinued.dll</VentFrameworkPath>

        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

    <PropertyGroup Condition=" '$(Platform)' == 'AnyCPU' ">
        <DefineConstants>$(DefineConstants);TRACE;PC</DefineConstants>
    </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="$(GameVersion)" PrivateAssets="all" />
		<PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
    <Reference Include="VentFrameworkContinued">
      <HintPath>$(VentFrameworkPath)</HintPath>
      <Private>true</Private>
    </Reference>
	</ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0">
            <IncludeAssets>runtime; compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0">
      <Aliases>JBAnnotations</Aliases>
    </PackageReference>
    <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-pre-release.21" />
    <PackageReference Include="GitInfo" Version="3.6.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  
  <Target Name="ValidateVentFramework" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(VentFrameworkPath)')" Text="Build the pinned VentFramework dependency with scripts/build.ps1 first, or set VentFrameworkPath to its DLL." />
  </Target>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(AmongUs)' != '' and '$(Platform)' == 'AnyCPU'">
    <Error Condition="!Exists('$(AmongUs)/Among Us.exe')" Text="AmongUs must point to an existing Among Us installation." />
    <Copy SourceFiles="$(TargetPath);$(VentFrameworkPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include=".\assets\projectlotus_bundle-win" />
    <EmbeddedResource Include=".\assets\projectlotus_bundle-android" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Condition="$(Platform)=='AnyCPU'" Include="./SourceGenerators/RoleEditorGenerator/src/RoleEditorGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
    
  <ItemGroup>
    <None Remove="./SourceGenerators/**/*" />
    <Content Remove="./SourceGenerators/**/*" />
    <Compile Remove="./SourceGenerators/**/*" />
  </ItemGroup>
    
  <ItemGroup>
    <Folder Include="src\GameModes\Normal\" />
  </ItemGroup>
</Project>
